{
  "name": "ai-governance-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && npm run lint",
    "build": "npm run check && vite build",
    "api:generate": "openapi-typescript ../api/openapi/management.json -o src/generated/api.ts",
    "api:check": "node scripts/check-api.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tdesign-react": "1.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
