# Copy to an ignored local .env and supply your own dedicated development DB.
# The program reads process environment; it does not automatically load this file.
AIGW_DATABASE_URL=
AIGW_OIDC_ISSUER=https://idp.example/realms/development
AIGW_OIDC_AUDIENCE=aigw-management
# Test-only legacy mock upstream; unused by normal real-provider startup.
AIGW_UPSTREAM_URL=

# Optional browser console. Register /auth/callback for this exact origin.
# A loopback HTTP origin also needs --allow-loopback-browser-http.
# Also the exact public origin used for device proofs. Configure HTTPS before
# enabling a project device policy; do not rewrite /api/v1 or /v1 at the proxy.
AIGW_BROWSER_ORIGIN=
AIGW_OIDC_CLIENT_ID=
AIGW_OIDC_CLIENT_SECRET=

# Normal startup manages real-provider metadata in PostgreSQL through the Web console.
# --providers <reviewed JSON file> remains a read-only compatibility mode.
# Inject these from the deployment secret store; never put keys in JSON or Git.
AIGW_ALIYUN_API_KEY=
AIGW_VOLCENGINE_API_KEY=
AIGW_ZHIPU_API_KEY=
AIGW_DEEPSEEK_API_KEY=

# Optional project opt-in content audit. Inject secrets from your deployment store.
# JSON object: immutable key ID -> standard base64 of random 32-byte KEK.
# Keep old key versions for retained records AND backup recovery; never commit values.
AIGW_CONTENT_AUDIT_KEYS=
AIGW_CONTENT_AUDIT_ACTIVE_KEY=

# Explicit platform administrator; exact OIDC issuer+subject, not an organization role.
# Both empty: configuration is readable but cannot be published through the API.
AIGW_PROVIDER_ADMIN_ISSUER=
AIGW_PROVIDER_ADMIN_SUBJECT=

# Optional encrypted supplier API Key editing through the Web console.
# JSON: immutable key ID -> base64 of random 32-byte AES key; inject outside Git.
# Separate from content-audit keys. Keep historical IDs through backup recovery.
AIGW_PROVIDER_ENCRYPTION_KEYS=
AIGW_PROVIDER_ENCRYPTION_ACTIVE_KEY=

# Explicit production auth mode: oidc (default) or local (offline accounts).
# Local requires AIGW_BROWSER_ORIGIN and local-admin initialization; no default user.
AIGW_AUTH_MODE=oidc

# Optional deployment-wide Prometheus endpoint; empty disables /metrics.
# Inject an independent random 32..256 visible-ASCII secret outside Git.
# Scraper, TSDB and backups must remain in mainland China.
AIGW_METRICS_TOKEN=

# Optional host monitoring and NetworkManager operations: exact system admin identity.
# Empty disables host access; organization owners have no implicit system privilege.
AIGW_SYSTEM_ADMIN_ISSUER=
AIGW_SYSTEM_ADMIN_SUBJECT=
# Stable per-machine identity; required when system administrator is configured.
AIGW_SYSTEM_NODE=
# Empty: read-only current namespace metrics. Root-owned local agent socket enables
# allowlisted IPv4/DNS changes only when the agent explicitly permits them.
AIGW_HOST_AGENT_SOCKET=

# Explicit new-api mode: --execution-engine=newapi --providers=/reviewed/models.json
# This mode reads prices/model aliases from the reviewed file, without vendor keys.
# new-api owns vendor credentials and needs a dedicated enabled service user/token.
AIGW_NEWAPI_ORIGIN=
AIGW_NEWAPI_SERVICE_TOKEN=
# Test-only; only a numeric loopback origin is accepted for plaintext HTTP.
AIGW_NEWAPI_ALLOW_LOOPBACK_HTTP=false
